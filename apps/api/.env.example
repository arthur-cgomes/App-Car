## Variables
NODE_ENV=development
PORT=3000
# Endereço do web (links dos e-mails) e origem permitida.
WEB_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
TRUST_PROXY=1

## DB
DATABASE_URL=postgres://monitoring:monitoring@localhost:5432/monitoring_car

## REDIS
REDIS_URL=redis://localhost:6379/0

## AUTH
# Produção: 32+ caracteres aleatórios (openssl rand -base64 48).
JWT_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres
REFRESH_COOKIE_PATH=/api/v1/auth

## SMS (console: só registra no log da API; smsdev: envia pelo SMSDev - www.smsdev.com.br; disabled: sem SMS, PIN só por e-mail)
SMS_PROVIDER=console
SMSDEV_KEY=

## E-MAIL
# Local: Mailpit (veja os e-mails em http://localhost:8025).
# Brevo: smtp://<login com @ trocado por %40>:<chave SMTP>@smtp-relay.brevo.com:587
# Resend: smtps://resend:<API_KEY>@smtp.resend.com:465
SMTP_URL=smtp://localhost:1025
# Em produção, um endereço verificado no provedor (ideal: domínio próprio autenticado).
MAIL_FROM=App Car <nao-responda@appcar.local>

## STORAGE
# gdrive: Google Drive (cliente OAuth "App para computador", veja docs/DEPLOY.md; refresh token e pasta saem de
# `pnpm -C apps/api drive:auth`). s3: S3-compatível, com S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY e
# S3_SECRET_KEY (local: SeaweedFS do docker-compose, porta 8333).
STORAGE_PROVIDER=gdrive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

## CONSULTA DE PLACA (mock até contratar um provedor)
PLATE_PROVIDER=mock
PLATE_LOOKUP_DAILY_LIMIT=10

## FIPE (API pública Parallelum; sem código FIPE, busca uma vez pela placa: poucas consultas por mês sem token, 30 com o token gratuito de fipe.api.br)
FIPE_PROVIDER=parallelum
FIPE_TOKEN=
